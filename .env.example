# Copy to `.env` and fill in. Never commit `.env`.

# --- Database (Prisma) ---
# Local (docker compose):
DATABASE_URL="postgresql://polyrecorder:polyrecorder@127.0.0.1:5434/polyrecorder?schema=public"

# Scaleway Managed PostgreSQL (prod) — set in GitHub secrets / Scaleway container env:
# Prefer sslmode=no-verify (encrypt without verifying Scaleway's private CA).
# The app also strips sslmode from the URL and sets rejectUnauthorized accordingly,
# so sslmode=require would work the same way if left by mistake.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/polyrecorder?schema=public&sslmode=no-verify"

# --- Auth / sessions ---
SESSION_SECRET=          # long random string — required in prod (no fallback)
APP_URL=http://localhost:5173

# --- Email (Scaleway Transactional Email) ---
SMTP_HOST=smtp.tem.scw.cloud
SMTP_PORT=587
SMTP_USER=               # Scaleway Project ID (UUID)
# SMTP_PASS=             # optional — falls back to SCW_SECRET_KEY
# From address is hardcoded: PolyRecorder <noreply@polyrecorder.app>

# --- Scaleway (deploy / TEM) ---
# SCW_SECRET_KEY=        # API secret — also used as SMTP password when SMTP_PASS unset
