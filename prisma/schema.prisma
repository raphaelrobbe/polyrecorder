generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Authenticated account (optional — guests work without one).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Display name (required). Uniqueness is case-insensitive via index `User_pseudo_lower_key`.
  /// Must not contain `@` (reserved for email login / @handle display).
  pseudo    String
  /// Null until the user first changes their pseudo from the auto-assigned default.
  pseudoCustomizedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  magicLinks MagicLink[]
  sessions   Session[]
  groups     Group[]
}

/// One-time email login / email-change token (store only the hash of the raw token).
model MagicLink {
  id        String    @id @default(cuid())
  email     String
  /// `login` | `email_change`
  purpose   String    @default("login")
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

/// Opaque browser session (cookie value hashed in tokenHash).
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Top-level personal folder (owned by one user; sharing comes later).
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Manual order among the user's groups (drag & drop in the library).
  sortOrder Int      @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  repertoires Repertoire[]

  @@index([userId])
  @@index([userId, sortOrder])
}

/// Musical repertoire inside a group.
model Repertoire {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Manual order among the group's repertoires.
  sortOrder Int      @default(0)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  songs Song[]

  @@index([groupId])
  @@index([groupId, sortOrder])
}

/// Musical work — a folder of recording sessions (parts).
model Song {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Last time one of this song's parts was opened / used for recording.
  lastOpenedAt DateTime @default(now())
  /// When true, anyone with the URL can open this song's parts read-only.
  isPublic  Boolean  @default(false)
  /// When true (and public), signed-in users may upload new tracks on this song.
  allowsCollaboration Boolean @default(false)
  /// Manual order among the repertoire's songs.
  sortOrder Int      @default(0)

  repertoireId String
  repertoire   Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  parts SongPart[]

  @@index([repertoireId])
  @@index([repertoireId, sortOrder])
  @@index([lastOpenedAt])
  @@index([isPublic])
}

/// Recording session / section of a song (beginning, middle, end…).
model SongPart {
  id        String   @id @default(cuid())
  /// Null until the owner names the session (shown as an italic placeholder).
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Last time this part was opened / used for recording.
  lastOpenedAt DateTime @default(now())
  /// Master mix bus level (1 = 100%). Owner-editable.
  masterVolume Float @default(1)
  /// Auto-align takes from 1-2-3-4 markers (session setting).
  autoAlignEnabled Boolean @default(true)
  /// Show beat/skew alignment warnings (session setting).
  showCalageWarnings Boolean @default(true)
  /// Skip count-in on playback when a valid beat was detected (session).
  skipCountInPlayback Boolean @default(true)
  /// Skip count-in on MP3 download when a valid beat was detected (session).
  skipCountInDownload Boolean @default(true)
  /// Optional metronome tempo (BPM). Null = no metronome on this session.
  metronomeBpm Int?
  /// Manual order among the song's parts (also drives deck prev/next).
  sortOrder Int      @default(0)

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  tracks TrackAsset[]

  @@index([songId])
  @@index([songId, sortOrder])
  @@index([lastOpenedAt])
}

/// Cloud-backed audio take for a song part (S3 object + metadata).
model TrackAsset {
  id            String    @id @default(cuid())
  name          String
  objectKey     String
  contentType   String
  byteSize      Int
  durationMs    Int
  offsetMs      Int       @default(0)
  /// Per-track mix level (1 = 100%). Song owner or uploader editable.
  volume        Float     @default(1)
  /// Mute in the mix. Song owner or uploader editable.
  muted         Boolean   @default(false)
  /// Manual order among the part's tracks (deck list + reference).
  sortOrder     Int       @default(0)
  /// Client-side track id at upload time (best-effort).
  clientTrackId Int?
  /// User who uploaded this take (owner or collaborator). Null on legacy rows.
  uploadedByUserId String?
  /// Null until the browser PUT + complete succeeds.
  uploadedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  songPartId String
  songPart   SongPart @relation(fields: [songPartId], references: [id], onDelete: Cascade)

  @@unique([objectKey])
  @@index([songPartId])
  @@index([songPartId, sortOrder])
  @@index([uploadedByUserId])
}
