generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Authenticated account (optional — guests work without one).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  /// Optional display name shown in the account menu.
  /// Uniqueness is case-insensitive via index `User_pseudo_lower_key`.
  pseudo    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  magicLinks MagicLink[]
  sessions   Session[]
  groups     Group[]
}

/// One-time email login / email-change token (store only the hash of the raw token).
model MagicLink {
  id        String    @id @default(cuid())
  email     String
  /// `login` | `email_change`
  purpose   String    @default("login")
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([expiresAt])
}

/// Opaque browser session (cookie value hashed in tokenHash).
model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Top-level personal folder (owned by one user; sharing comes later).
model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  repertoires Repertoire[]

  @@index([userId])
}

/// Musical repertoire inside a group.
model Repertoire {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  songs Song[]

  @@index([groupId])
}

/// A polyphonic song / session (tracks layered together).
model Song {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Last time this song was opened / used for recording.
  lastOpenedAt DateTime @default(now())
  /// When true, anyone with the URL can open the song read-only.
  isPublic  Boolean  @default(false)

  repertoireId String
  repertoire   Repertoire @relation(fields: [repertoireId], references: [id], onDelete: Cascade)

  tracks TrackAsset[]

  @@index([repertoireId])
  @@index([lastOpenedAt])
  @@index([isPublic])
}

/// Cloud-backed audio take for a song (S3 object + metadata).
model TrackAsset {
  id            String    @id @default(cuid())
  name          String
  objectKey     String
  contentType   String
  byteSize      Int
  durationMs    Int
  offsetMs      Int       @default(0)
  /// Client-side track id at upload time (best-effort).
  clientTrackId Int?
  /// Null until the browser PUT + complete succeeds.
  uploadedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  songId String
  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@unique([objectKey])
  @@index([songId])
}
